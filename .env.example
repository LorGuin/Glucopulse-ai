# Firebase (público, va en el bundle del cliente - normal para Firebase)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Gemini (SIN prefijo VITE_ a propósito: solo la lee el servidor, en
# server/gemini.ts, nunca llega al navegador). Conseguila en
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: cambiar de modelo sin tocar código (por defecto gemini-flash-latest)
# GEMINI_MODEL=gemini-flash-latest
# Opcional: modelo de respaldo si el principal está saturado (por defecto gemini-flash-lite-latest)
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Monitoreo de testers: mails (separados por coma) que pueden ver el panel #/admin.
# También hay que ponerlos en firestore.rules (función isAdmin).
VITE_ADMIN_EMAILS=cristianminni@gmail.com
